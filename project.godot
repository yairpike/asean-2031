; Engine configuration file.
config_version=5

[application]
config/name="ASEAN 2031"
run/main_scene="res://game/boot.tscn"
config/features=PackedStringArray("4.7")

[autoload]

SMTouch="*res://addons/rts_advanced/sm_touch.gd"

[debug]
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0

[gui]
theme/custom="res://assets/theme/game_theme.tres"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[internationalization]
locale/translations=PackedStringArray("res://localization/demo.en.translation", "res://localization/demo.fr.translation")

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
